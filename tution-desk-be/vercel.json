{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/generate-fees",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-fee-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/process-admission-welcome",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/reconcile-queue",
      "schedule": "*/15 * * * *"
    }
  ]
}
