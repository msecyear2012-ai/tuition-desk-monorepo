# ==============================================================================
# TuitionDesk Backend — Environment Template (.env.example)
# NOTE: Placeholders only. Do NOT commit real secrets or production credentials.
# ==============================================================================

NODE_ENV=development
PORT=3001

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# JWT Authentication Secret (min 32 characters; generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_jwt_secret_min_32_characters

# Internal WhatsApp Microservice Integration
WHATSAPP_INTERNAL_SECRET=replace_with_whatsapp_internal_secret
WHATSAPP_SERVICE_URL=http://127.0.0.1:3005
WHATSAPP_MODE=simulation
ENABLE_LIVE_WHATSAPP=false
ENABLE_ADMISSION_WELCOME_WHATSAPP=false

# Payment Gateway Webhook Secret
YOUPI_WEBHOOK_SECRET=replace_with_youpi_webhook_secret

# Vercel Cron Secret (generate via: openssl rand -hex 32)
CRON_SECRET=replace_with_cron_secret

# Application URLs & CORS
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ImageKit - Payment Proof Storage
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
